{
  "runtime_preset": "baseline",
  "batching_mode": "mixed",
  "speculative_policy": "off",
  "metadata_backend": "reuse",
  "enable_mixed_graph": false,
  "enable_prefix_caching": true,
  "host_kv_cache_bytes": 1073741824,
  "host_kv_async_prefetch": true,
  "host_kv_prefetch_max_inflight_blocks": 4,
  "host_kv_min_restore_tokens": 256,
  "host_kv_max_restore_blocks": 8,
  "max_kvcache_blocks": 16,
  "max_model_len": 2048,
  "max_num_seqs": 8,
  "max_num_batched_tokens": 512,
  "prefill_chunk_size": 128,
  "max_prefill_steps": 1,
  "tensor_parallel_size": 1,
  "kv_cache_dtype": "model",
  "sampler_backend": "torch",
  "gpu_memory_utilization": 0.65,
  "enforce_eager": false
}
