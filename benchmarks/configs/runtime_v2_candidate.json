{
  "runtime_preset": "baseline",
  "batching_mode": "mixed",
  "speculative_policy": "adaptive",
  "metadata_backend": "reuse",
  "enable_mixed_graph": true,
  "mixed_attention_backend": "split",
  "enforce_eager": false,
  "rmsnorm_backend": "torch",
  "mlp_backend": "torch",
